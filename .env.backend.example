APP_ENV=development
DATABASE_URL=postgresql+psycopg://deeplitics:local-only-password@127.0.0.1:5433/deeplitics
OIDC_ISSUER=https://identity.example.eu/
OIDC_AUDIENCE=https://api.deeplitics.example
OIDC_JWKS_URL=https://identity.example.eu/.well-known/jwks.json
# Public OIDC client used by the /app interface. Register the redirect URI with the provider.
OIDC_CLIENT_ID=deeplitics-web
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.eu/oauth2/authorize
OIDC_TOKEN_ENDPOINT=https://identity.example.eu/oauth2/token
OIDC_REDIRECT_URI=http://127.0.0.1:5000/app/
# Optional fixed tenant for a single-workspace deployment; otherwise users enter the ID from their invite.
DEFAULT_TENANT_ID=
# Generate a fresh key for local development. Never commit the generated value.
DATA_ENCRYPTION_KEYS_JSON='{"dev-1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}'
DATA_ENCRYPTION_ACTIVE_KEY=dev-1
IDENTITY_LOOKUP_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Leave empty for same-origin requests. Otherwise use a comma-separated exact-origin allowlist.
CORS_ORIGINS=
